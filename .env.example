# ssh target for scripts/deploy.sh; not needed on the server.
DEPLOY_HOST=

# From @BotFather.
BOT_TOKEN=
# Domain pointing at this VPS; Caddy gets the certificate for it.
APP_DOMAIN=kcal.example.com
# Telegram user ids allowed to use the bot, comma-separated. Empty = anyone.
# A stranger who presses /start gets their id back to send you.
ALLOW_USER_IDS=
# Your own Telegram id: you get a message about every new person (with a
# Block button) and when someone hits the spend cap; /block and /unblock work.
ADMIN_USER_ID=
# Compliments and dancing cats for these people: Telegram ids or usernames,
# comma-separated. Empty = nobody. TREATS_DIR holds compliments.txt and
# cats/*.mp4 (see api/internal/treats); scripts/push-treats.sh fills it.
TREAT_USERS=
TREATS_DIR=/var/lib/kcal-bot/treats
# Model calls per user per UTC day; 0 = no cap.
DAILY_ANALYSIS_LIMIT=30
# Model spend per user per UTC day, USD; 0 = no cap. Needs a priced model (Claude).
DAILY_SPEND_LIMIT_USD=0.5
# Model spend of everyone together per UTC day, USD; 0 = no cap.
DAILY_TOTAL_SPEND_LIMIT_USD=5

# gemini | claude. Empty picks whichever key is set (Gemini first).
ESTIMATOR=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# low | medium | high — reasoning effort, the bulk of the per-call cost.
CLAUDE_EFFORT=medium
